# OMI app and db variables
MODE=test
POSTGRES_USER=omi_user
POSTGRES_PASSWORD=omi_password
POSTGRES_DB=omi_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Notification limits are fixed by the deployed policy: 1-2 reminders and
# 1-2 recommendations/resources per local day when those classes are supplied.
# The policy artifacts define quiet hours, spacing, and the total weekly cap.
ARTEMIS_HOST=localhost
ARTEMIS_PORT=61613
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis
ARTEMIS_QUEUE=int.ibechange.update::tue-updates-int
# For the reference orchestrator, export the destination settings it should use.
# CS_BASE_URL=http://cs-rct-cs-api-1:8000
# OMI_BASE_URL=http://app:3200
# EUT_PRE_BASE_URL=https://your-vu-host
# EUT_PRE_TOKEN=
# ARTEMIS_QUEUE_NOTIFICATION_PLANS=omi.notification_plans
POLICY_LEARNING_MODE=online
# Use frozen for a fixed trial policy; online refits each participant's own stream.
POLICY_TIMEZONE=Europe/Berlin
# Optional directory containing both versioned ConCDDQN models and replay archives.
# POLICY_ARTIFACT_DIR=/app/app/policy_artifacts
# Time zone used for Artemis task interval timestamps that have no offset.
ARTEMIS_SCHEDULE_TIMEZONE=Europe/Berlin
# Optional TLS settings
# ARTEMIS_CA_CERT=/path/to/ca.pem
# ARTEMIS_CLIENT_CERT=/path/to/client.pem
# ARTEMIS_CLIENT_KEY=/path/to/client.key
# Metabase internal database (metabase_db) variables
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase_db
MB_DB_PORT=5432
MB_DB_USER=metabase_user
MB_DB_PASS=metabase_password
MB_DB_HOST=metabase_db
# Metabase internal Postgres service variables
POSTGRES_USER_METABASE=metabase_user
POSTGRES_PASSWORD_METABASE=metabase_password
POSTGRES_DB_METABASE=metabase_db
